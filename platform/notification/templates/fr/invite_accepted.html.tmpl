<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><title>Nouveau membre</title></head>
<body style="font-family:sans-serif;color:#1a1a1a;max-width:560px;margin:0 auto;padding:32px 16px">
  <h2 style="font-size:20px;font-weight:600;margin-bottom:8px">👋 {{.InviteeName}} a rejoint {{.TenantName}}</h2>
  <p style="margin:0 0 16px">
    Bonjour {{.InviterName}},<br><br>
    <strong>{{.InviteeName}}</strong> ({{.InviteeEmail}}) a accepté votre invitation et est maintenant membre de
    <strong>{{.TenantName}}</strong> avec le rôle <em>{{.Role}}</em>.
  </p>
  <a href="{{.TeamURL}}"
     style="display:inline-block;background:#18181b;color:#fff;text-decoration:none;padding:10px 20px;border-radius:6px;font-size:14px">
    Voir l'équipe
  </a>
  <p style="margin-top:32px;font-size:12px;color:#71717a">
    Vous recevez cet email car vous avez invité {{.InviteeEmail}} dans {{.TenantName}}.
  </p>
</body>
</html>
