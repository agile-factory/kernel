# ============================================================================
# SERVER CONFIG
# ============================================================================
ENVIRONMENT=development
PORT=8080
APP_URL=http://localhost:8080

# ============================================================================
# DATABASE (PostgreSQL 15 + PostGIS)
# ============================================================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/immobilier_saas?sslmode=disable

# Production example:
# DATABASE_URL=postgres://username:password@prod-db.region.rds.amazonaws.com:5432/immobilier_saas?sslmode=require

# ============================================================================
# REDIS CACHE
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# Production example:
# REDIS_URL=rediss://:password@prod-redis.region.cache.amazonaws.com:6379/0

# ============================================================================
# JWT AUTHENTICATION (RS256)
# ============================================================================
# Generate keys with:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem

JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7...
-----END PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAu7V...
-----END PUBLIC KEY-----"

JWT_EXPIRY=900  # 15 minutes in seconds

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Production:
# CORS_ORIGINS=https://app.immobilier.com,https://www.immobilier.com

# ============================================================================
# AWS S3 (or MinIO for local)
# ============================================================================
S3_BUCKET=immobilier-saas-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_PRESIGN_EXPIRY=3600  # 1 hour

# For MinIO local development:
S3_ENDPOINT=http://localhost:9000
S3_USE_PATH_STYLE=true

# ============================================================================
# NATS MESSAGE QUEUE
# ============================================================================
NATS_URL=nats://localhost:4222

# Production with auth:
# NATS_URL=nats://username:password@nats.prod.com:4222

# ============================================================================
# EMAIL (AWS SES)
# ============================================================================
EMAIL_PROVIDER=ses  # "ses" or "smtp"
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@immobilier.example.com
SES_FROM_NAME=Immobilier SaaS

# For SMTP (alternative):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================================================
# SMS (Twilio)
# ============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_FROM=+221123456789

# ============================================================================
# PAYMENT PROVIDERS
# ============================================================================

# Wave Mobile Money (Senegal)
WAVE_API_KEY=wave_test_sk_xxxxxxxxxxxxx
WAVE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
WAVE_API_URL=https://api.wave.com/v1

# Orange Money
ORANGE_API_KEY=orange_xxxxxxxxxxxxx
ORANGE_WEBHOOK_SECRET=orange_whsec_xxxxxxxxxxxxx
ORANGE_API_URL=https://api.orange-money.com/v1

# Free Money
FREE_API_KEY=free_xxxxxxxxxxxxx
FREE_WEBHOOK_SECRET=free_whsec_xxxxxxxxxxxxx
FREE_API_URL=https://api.freemoney.com/v1

# ============================================================================
# DOCUSIGN (E-Signature)
# ============================================================================
DOCUSIGN_INTEGRATION_KEY=your_integration_key
DOCUSIGN_USER_ID=your_user_id
DOCUSIGN_ACCOUNT_ID=your_account_id
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# ============================================================================
# OBSERVABILITY
# ============================================================================

# Sentry Error Tracking
SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxxxxxxxxxx

# Prometheus metrics endpoint (exposed on /metrics)
PROMETHEUS_ENABLED=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_MAX=100  # requests per window
RATE_LIMIT_EXPIRATION=60  # seconds

# ============================================================================
# SECURITY
# ============================================================================
# Argon2 password hashing (default params are secure)
PASSWORD_HASH_MEMORY=65536  # 64MB
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=2

# Session expiry
REFRESH_TOKEN_EXPIRY=604800  # 7 days in seconds
