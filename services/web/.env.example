# ============================================================================
# PUBLIC VARIABLES (exposed to browser)
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Maps (for location search)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Mapbox (alternative to Google Maps)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenStreetMap (free alternative - no key needed)
# Used by default with Leaflet

# DocuSign (for embedded signing)
NEXT_PUBLIC_DOCUSIGN_INTEGRATION_KEY=your_integration_key

# Sentry (frontend error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxxxxxxxxxx

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# SERVER-SIDE ONLY VARIABLES (not exposed to browser)
# ============================================================================

# Internal API URL (for server-side fetching)
API_URL=http://api:8080

# Secret for webhooks validation
WEBHOOK_SECRET=your_webhook_secret_key

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================
NODE_ENV=development

# Enable/disable PWA
NEXT_PUBLIC_PWA_ENABLED=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================
NEXT_PUBLIC_FEATURE_COMPARE=true
NEXT_PUBLIC_FEATURE_FAVORITES=true
NEXT_PUBLIC_FEATURE_BOOKING=true
NEXT_PUBLIC_FEATURE_PAYMENT_WAVE=true
NEXT_PUBLIC_FEATURE_PAYMENT_ORANGE=true
NEXT_PUBLIC_FEATURE_PAYMENT_FREE=true
NEXT_PUBLIC_FEATURE_PAYMENT_CARD=false  # Stripe integration TBD

# ============================================================================
# PRODUCTION EXAMPLES
# ============================================================================

# Production URLs:
# NEXT_PUBLIC_APP_URL=https://www.immobilier.com
# NEXT_PUBLIC_API_URL=https://api.immobilier.com

# CDN for images:
# NEXT_PUBLIC_CDN_URL=https://cdn.immobilier.com
